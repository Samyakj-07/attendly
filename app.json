{
  "expo": {
    "name": "IPU Attendance OS",
    "slug": "ipu-attendance-os",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#080B11"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ipu.attendanceos"
    },
    "android": {
      "package": "com.ipu.attendanceos",
      "versionCode": 1,
      "permissions": [],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#080B11"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    }
  }
}
